{
  "autoload": {
    "psr-4": {
      "AuthServer\\": "src/"
    },
    "files": [
      "src/functions.php"
    ]
  },
  "repositories": {},
  "require": {
    "slim/slim": "^4.0",
    "slim/psr7": "^1.0",
    "slim/php-view": "^3.0",
    "php-di/slim-bridge": "^3.0",
    "monolog/monolog": "^3.0"
  },
  "require-dev": {
    "phpstan/phpstan": "^1.10",
    "squizlabs/php_codesniffer": "3.*",
    "phpunit/phpunit": "^11.0",
    "mockery/mockery": "^1.6"
  },
  "autoload-dev": {
    "psr-4": {
      "AuthServer\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "serve": [
      "Composer\\Config::disableProcessTimeout",
      "php -S localhost:8000 -t public router.php"
    ],
    "stan": "phpstan analyse -l 5 src public/index.php",
    "cs_check": "phpcs src public/index.php --standard=PSR12",
    "cs_fix": "phpcbf src public/index.php --standard=PSR12",
    "test": "@php vendor/bin/phpunit",
    "check": [
      "@stan",
      "@cs_check"
    ]
  }
}
